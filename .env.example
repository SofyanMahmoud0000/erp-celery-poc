# Copy to .env and adjust as needed. Matches docker-compose.yml service names/ports.

SECRET_KEY=dev-secret
PORT=5007
DEBUG=True

SCHEMA_NAME=erp_celery_poc
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/erp_celery_poc

# Broker = Postgres via kombu's `sqla+` transport, matching erp-managment's
# actual `.env` (`CELERY_BROKER_URL=sqla+postgresql://...` under `[CELERY]`)
# -- NOT Redis. If unset, defaults to `sqla+` + POSTGRES_URL above (see
# src/config/config.py).
CELERY_BROKER_URL=sqla+postgresql://postgres:postgres@postgres:5432/erp_celery_poc
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@postgres:5432/erp_celery_poc

# Demo periodic task interval (seconds) -- short here on purpose so the
# reproduction/fix behavior is observable in a couple of minutes.
DB_WRITE_TASK_INTERVAL_SECONDS=15

CELERY_TASK_TIME_LIMIT=60
CELERY_TASK_SOFT_TIME_LIMIT=45
DEFAULT_HTTP_TIMEOUT_SECONDS=5

# kombu_message (the sqla+ broker's own message table) grows forever --
# consumed rows are only marked visible=false, never deleted. This purges
# rows older than KOMBU_MESSAGE_RETENTION_SECONDS every
# KOMBU_MESSAGE_CLEANUP_INTERVAL_SECONDS.
KOMBU_MESSAGE_CLEANUP_INTERVAL_SECONDS=3600
KOMBU_MESSAGE_RETENTION_SECONDS=86400
